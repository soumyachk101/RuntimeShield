# RuntimeShield control plane environment.
# Copy to `.env` and set values; never commit a populated .env.
#
# No values below are secrets except the two key material vars —
# generate those with: openssl rand -hex 32

# --- storage backend ---------------------------------------------------------
# "sqlite" (default, no external service) or "postgres"
RUNSHIELD_BACKEND=sqlite
# SQLite data file (relative to the working directory).
RUNSHIELD_SQLITE_PATH=data/runshield.db
# PostgreSQL DSN, required when RUNSHIELD_BACKEND=postgres.
#RUNSHIELD_PG_DSN=postgres://user:pass@localhost:5432/runshield?sslmode=disable

# --- HTTP -------------------------------------------------------------------
RUNSHIELD_HTTP_ADDR=:8080
# TLS (optional; omit both for plain HTTP dev).
#RUNSHIELD_TLS_CERT=
#RUNSHIELD_TLS_KEY=

# --- keys (secret material; generate, do not reuse across environments) -----
# 32-byte hex signing key for policy bundles + device tokens.
#RUNSHIELD_SIGN_KEY=<openssl rand -hex 32>
# 32-byte hex key for operator session tokens.
#RUNSHIELD_SESSION_KEY=<openssl rand -hex 32>
# 32-byte hex key for operator API tokens. WHEN SET, the API is keyed:
# operator endpoints require a valid operator token and device endpoints
# (except the first enrol) require a valid device token. WHEN UNSET, the
# API runs in dev-open mode: requests pass through, a WARN is logged per
# unauthenticated request, and responses carry `X-RS-Dev-Mode: true`.
#RUNSHIELD_OPERATOR_KEY=<openssl rand -hex 32>

# --- CORS ----------------------------------------------------------------------
# Comma-separated allowed origins (e.g. https://console.example.com).
# When unset, the API answers cross-origin requests with `*` (dev mode).
#RUNSHIELD_CORS_ORIGINS=

# --- rate limiting ----------------------------------------------------------
# Legacy single-class knob (still honored by consumers that build a bare
# limiter). The per-class budgets below drive the real route classes.
RUNSHIELD_RATE_LIMIT_RPS=50
RUNSHIELD_RATE_LIMIT_BURST=100
# Per-class overrides (class, default RPS/burst, env knobs):
#   events     50/100  /v1/events/batch        (audit ingestion, highest)
#   enrol       5/10   /v1/devices/enrol       (bootstrapping, lowest)
#   heartbeat  10/20   /v1/devices/{id}/heartbeat
#   device     20/40   /v1/devices/{id}/policy + /v1/devices/{id}/token
#   operator   10/20   policies/orgs/users/devices/decisions/approvals
#RUNSHIELD_RATE_EVENTS_RPS=50
#RUNSHIELD_RATE_EVENTS_BURST=100
#RUNSHIELD_RATE_ENROL_RPS=5
#RUNSHIELD_RATE_ENROL_BURST=10
#RUNSHIELD_RATE_HEARTBEAT_RPS=10
#RUNSHIELD_RATE_HEARTBEAT_BURST=20
#RUNSHIELD_RATE_DEVICE_RPS=20
#RUNSHIELD_RATE_DEVICE_BURST=40
#RUNSHIELD_RATE_OPERATOR_RPS=10
#RUNSHIELD_RATE_OPERATOR_BURST=20

# --- logging ----------------------------------------------------------------
# debug | info | warn | error
RUNSHIELD_LOG_LEVEL=info

# --- optional NATS transport (spec §5). Empty = file-spool-only dev mode.
#RUNSHIELD_NATS_URL=nats://localhost:4222

# --- policy schema (path to the JSON schema used for validation) -----------
#RUNSHIELD_POLICY_SCHEMA=policies/schema/policy.schema.json

# --- agent-side (used by the Rust CLI, documented here for completeness) ---
#RUNSHIELD_CONTROL_PLANE=http://localhost:8080
#RUNSHIELD_DATA_DIR=~/.runshield
#RUNSHIELD_POLICY_KEY=<same value as RUNSHIELD_SIGN_KEY>
